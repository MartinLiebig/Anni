# Never serve local config backups or SQL dumps if they end up in the web root.
<FilesMatch "\.(sql|local\.php|example|md|log|pgn|tsv)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
Options -Indexes

# Revalidate app shell and JS/CSS on load so deploys take effect immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
